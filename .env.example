# Copy to .env.local and fill in. NEVER commit real credentials.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser — everything
# else stays on the server.

# ── Site ─────────────────────────────────────────────────────────────────────
# Your public domain, e.g. https://www.bijugeorge.ca. If unset/empty, Vercel's
# production domain (or deployment URL) is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── REALTOR.ca DDF® Web API (server-only) ────────────────────────────────────
# Your DDF data feed ("destination") username and password. CREA's OAuth token
# endpoint takes them as client_id / client_secret. Either naming works.
DDF_CLIENT_ID=
DDF_CLIENT_SECRET=
# DDF_USERNAME=
# DDF_PASSWORD=

# auto (default): live when credentials are set, otherwise mock sample data
# live: always call DDF (fails loudly if credentials are missing)
# mock: always use the local sample dataset
DDF_MODE=auto

# Your data feed's Destination ID (shown in the DDF portal). Enables CREA
# listing-view analytics reporting.
DDF_DESTINATION_ID=

# Optional overrides (defaults shown)
# DDF_TOKEN_URL=https://identity.crea.ca/connect/token
# DDF_API_BASE_URL=https://ddfapi.realtor.ca/odata/v1
# DDF_TIMEOUT_MS=10000

# ── Leads database (server-only) ─────────────────────────────────────────────
# PostgreSQL connection string. Run `npm run db:migrate` after setting it.
# When empty in development, leads are saved to .data/leads.json instead.
DATABASE_URL=
# verify (default) | no-verify | off
# DATABASE_SSL=verify
# auto (default) | postgres | file
# LEAD_STORE=auto

# ── Realtor overrides (optional — defaults live in config/realtor.ts) ────────
REALTOR_NAME=
REALTOR_EMAIL=
REALTOR_PHONE=

# ── Email notifications (server-only) ────────────────────────────────────────
# console (default in dev: prints to terminal) | resend | none (default in prod)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="Website Leads <leads@yourdomain.ca>"
# Where new-lead notifications go (defaults to the realtor's email)
LEAD_NOTIFICATION_EMAIL=

# ── CRM / automation webhook (server-only, optional) ─────────────────────────
# Every new lead is POSTed here as JSON (Zapier, Make, n8n, HubSpot workflows…)
LEAD_WEBHOOK_URL=
# If set, requests include X-Signature: sha256=<HMAC of body>
LEAD_WEBHOOK_SECRET=

# ── Admin API (server-only, optional) ────────────────────────────────────────
# Enables GET/PATCH /api/admin/leads with "Authorization: Bearer <token>".
# Use a long random value (min 24 chars), e.g. `openssl rand -hex 32`.
ADMIN_API_TOKEN=

# ── Maps (public, optional) ──────────────────────────────────────────────────
# Leave empty to use OpenStreetMap (no key needed). A Google Maps *Embed API*
# key is public by design — restrict it to your domain in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# ── Analytics (public, optional) ─────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
